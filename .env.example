# ========================================================
# VARIABLES DE ENTORNO PARA CLUB MURANO VOLEY
# ========================================================

# Cadena de conexión PostgreSQL (Supabase):
# Ve a tu proyecto en Supabase -> Project Settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql://postgres:[TU_PASSWORD]@db.[TU_PROJECT_REF].supabase.co:5432/postgres

# Puerto local (opcional)
PORT=3000

# Entorno: development | production
NODE_ENV=production
